# Build membaca .env ini. Tidak dipakai oleh JavaScript browser.
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
# Opsional: hanya untuk dataset private; token Viewer, bukan Editor.
SANITY_READ_TOKEN=
# Hanya migrasi lokal --apply. Jangan masukkan ke Vercel atau SANITY_STUDIO_*.
SANITY_WRITE_TOKEN=
